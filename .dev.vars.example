# Cloudflare Pages Functions local development secrets
# Copy this file to .dev.vars and fill in the values below.
# .dev.vars is gitignored by default — do NOT commit it.
# Get your GEMINI key from: https://aistudio.google.com/apikey
# Get SUPABASE_URL + SUPABASE_SERVICE_KEY from: Supabase Dashboard → Project Settings → API

GEMINI_API_KEY=replace_with_your_gemini_api_key
SUPABASE_URL=replace_with_your_supabase_url
SUPABASE_SERVICE_KEY=replace_with_your_supabase_service_role_key
